# Repository checkout
GIT_REPO=https://github.com/achetverikov/demixing_model.git
GIT_REF=main
WORKDIR=/workspace
REPO_DIR=/workspace/demixing_model

# Redis Cloud
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_LOCK_PREFIX=demixing:lock:
REDIS_COMPLETED_PREFIX=demixing:completed:

# S3-compatible object storage, e.g. Backblaze B2 or Cloudflare R2
S3_BUCKET=
S3_PREFIX=demixing/averaged_surfaces_v1
S3_ENDPOINT_URL=https://<provider-s3-endpoint>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Worker/runtime settings
AVERAGED_SURFACES_DIR=results/averaged_surfaces_vast
COMPLETION_REGISTRY=averaged_surfaces_vast
BUNDLE_OUTPUT=1
BUNDLE_DIR=results/averaged_surfaces_vast_bundles
N_SIMULATIONS=10000
N_SAMPLES=100
LOCK_TTL=1800
GPU_WORKERS=0
EXTRA_ARGS=--grid-level 1
