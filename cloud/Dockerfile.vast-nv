FROM nvcr.io/nvidia/jax:26.09-py3@sha256:53895f7648fbeb384cabacc1f69f2ec27ec4b2d371ee3f7af50c759f198a44ca

WORKDIR /workspace

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHON_BIN=python3

COPY .devcontainer/requirements.txt /opt/demixing/requirements.txt
RUN python3 -m pip install --upgrade pip \
    && python3 -m pip install --upgrade --upgrade-strategy eager \
      -r /opt/demixing/requirements.txt 'jax[cuda13-local]==0.11.2' \
    && python3 -m pip check

CMD ["bash", "-lc", "if [ -f cloud/vast_worker.sh ]; then bash cloud/vast_worker.sh; else sleep infinity; fi"]
