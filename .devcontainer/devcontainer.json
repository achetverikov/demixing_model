{
  "name": "demixing-jax-r",
  "build": { "dockerfile": "Dockerfile.jax-r", "context": ".." },
  "mounts": [
    "source=r-lib-4.6-20261009,target=/home/vscode/R/library,type=volume",
    "source=r-mcp-state,target=/root/.cache,type=volume",
    "source=demixing-model-venv-20261009,target=/workspaces/.venv,type=volume"
  ],
  "runArgs": [
    "--gpus", "all",
    "--ipc=host",
    "--ulimit", "memlock=-1",
    "--ulimit", "stack=67108864"
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "username": "vscode"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "reditorsupport.r"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/.venv/bin/python"
      }
    }
  },
  "remoteEnv": {
    "JAX_DEFAULT_MATMUL_PRECISION": "highest",
    "PYTHONPYCACHEPREFIX": "/tmp/demixing-python-cache",
    "JAX_COMPILATION_CACHE_DIR": "/tmp/demixing-jax-cache",
    "PYTEST_ADDOPTS": "-o cache_dir=/tmp/demixing-pytest-cache",
    "PYTHONPATH": "/workspaces/demixing_model/demixing_model",
    "R_LIBS_USER": "/home/vscode/R/library",
    "XLA_PYTHON_CLIENT_PREALLOCATE": "false",
    "DEMIXING_ARTIFACT_ROOT": "/workspaces/demixing_model/results"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ripgrep && sudo mkdir -p /home/vscode/R/library && sudo chown -R vscode:vscode /home/vscode/R /workspaces/.venv && python3 -u .devcontainer/install_python_packages_if_missing.py && Rscript .devcontainer/install_r_packages_if_missing.R"
}
