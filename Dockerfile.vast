FROM vastai/base-image:cuda-13.0.2-cudnn-devel-ubuntu22.04-py311

WORKDIR /workspace

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHON_BIN=/venv/main/bin/python
ENV PATH="/venv/main/bin:${PATH}"

RUN pip install --upgrade pip setuptools wheel && \
    pip install \
      "jax[cuda13-local]==0.10.1" \
      flax==0.10.7 \
      optax==0.2.5 \
      numpy==2.1.3 \
      pandas==2.3.1 \
      matplotlib==3.10.3 \
      seaborn==0.13.2 \
      pyarrow==21.0.0 \
      boto3==1.34.162 \
      redis==6.4.0 \
      streamlit==1.47.0 \
      plotly==6.2.0

CMD ["bash", "-lc", "if [ -f cloud/vast_worker.sh ]; then bash cloud/vast_worker.sh; else sleep infinity; fi"]
